{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx tsx script/vercel-build.ts",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "server/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
